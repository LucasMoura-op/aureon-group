generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  OWNER
  PARTNER
  EDITOR
  VIEWER
}

enum ProjectType {
  LAND_PURCHASE
  CONSTRUCTION
  STUDIOS
  CONTAINERS
  HOSPITALITY
  TOWNHOUSE
  RENTAL
  RENOVATION
  AUCTION_PROPERTY
  LEASE
  CATTLE
  FINANCING
  CONSORTIUM
}

enum ProjectStatus {
  IDEA
  ANALYZING
  APPROVED
  RUNNING
  PAUSED
  FINISHED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionType {
  REVENUE
  EXPENSE
  INVESTMENT
  DEBT
  INSTALLMENT
  CONTRIBUTION
  WITHDRAWAL
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FinancingSystem {
  SAC
  PRICE
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  auditLogs   AuditLog[]
  tasks       Task[]               @relation("AssignedTasks")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                  OrganizationMember[]
  projects                 Project[]
  suppliers                Supplier[]
  financialTransactions    FinancialTransaction[]
  regionResearches         RegionResearch[]
  externalDataSources      ExternalDataSource[]
  businessIdeas            BusinessIdea[]
  decisionReports          DecisionReport[]
  fileAttachments          FileAttachment[]
  auditLogs                AuditLog[]
  tasks                    Task[]
  alerts                   Alert[]
  aiAnalyses               AIAnalysis[]
  loanProposals            LoanProposal[]
  financialHealthSnapshots FinancialHealth[]
  wealthProjections        WealthProjection[]
}

model OrganizationMember {
  id             String     @id @default(uuid())
  organizationId String
  userId         String
  role           MemberRole @default(VIEWER)
  equityPercent  Decimal?   @db.Decimal(8, 4)
  invitedEmail   String?
  invitedAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model Project {
  id                     String        @id @default(uuid())
  organizationId         String
  name                   String
  type                   ProjectType
  city                   String
  state                  String
  neighborhood           String
  address                String?
  lotAreaM2              Decimal?      @db.Decimal(12, 2)
  builtAreaM2            Decimal?      @db.Decimal(12, 2)
  purchaseValue          Decimal       @default(0) @db.Decimal(14, 2)
  saleValue              Decimal       @default(0) @db.Decimal(14, 2)
  monthlyRent            Decimal       @default(0) @db.Decimal(14, 2)
  termMonths             Int           @default(0)
  ownCapital             Decimal       @default(0) @db.Decimal(14, 2)
  financedCapital        Decimal       @default(0) @db.Decimal(14, 2)
  consortiumCapital      Decimal       @default(0) @db.Decimal(14, 2)
  perceivedRisk          RiskLevel     @default(MEDIUM)
  status                 ProjectStatus @default(ANALYZING)
  notes                  String?
  score                  Int?
  verdict                String?
  roi                    Decimal?      @db.Decimal(8, 4)
  netMargin              Decimal?      @db.Decimal(8, 4)
  paybackMonths          Int?
  safetyMargin           Decimal?      @db.Decimal(8, 4)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenarios              ProjectScenario[]
  risks                  ProjectRisk[]
  financingSimulations   FinancingSimulation[]
  consortiumSimulations  ConsortiumSimulation[]
  constructionBudgets    ConstructionBudget[]
  stages                 ConstructionStage[]
  materials              Material[]
  transactions           FinancialTransaction[]
  attachments            FileAttachment[]
  tasks                  Task[]
  alerts                 Alert[]
  aiAnalyses             AIAnalysis[]
  loanProposals          LoanProposal[]
  decisionReports        DecisionReport[]

  @@index([organizationId, status])
  @@index([organizationId, type])
}

model ProjectScenario {
  id                String   @id @default(uuid())
  projectId         String
  name              String
  constructionCost  Decimal  @default(0) @db.Decimal(14, 2)
  landPrice         Decimal  @default(0) @db.Decimal(14, 2)
  annualInterest    Decimal  @default(0) @db.Decimal(8, 4)
  inflation         Decimal  @default(0) @db.Decimal(8, 4)
  delayMonths       Int      @default(0)
  vacancyRate       Decimal  @default(0) @db.Decimal(8, 4)
  monthlyRent       Decimal  @default(0) @db.Decimal(14, 2)
  salePrice         Decimal  @default(0) @db.Decimal(14, 2)
  appreciation      Decimal  @default(0) @db.Decimal(8, 4)
  taxes             Decimal  @default(0) @db.Decimal(14, 2)
  materialCost      Decimal  @default(0) @db.Decimal(14, 2)
  laborCost         Decimal  @default(0) @db.Decimal(14, 2)
  termMonths        Int      @default(0)
  safetyMargin      Decimal  @default(0) @db.Decimal(8, 4)
  calculatedPayload Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRisk {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String
  level       RiskLevel @default(MEDIUM)
  probability Decimal   @default(0) @db.Decimal(8, 4)
  impact      Decimal   @default(0) @db.Decimal(14, 2)
  mitigation  String?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model FinancingSimulation {
  id              String          @id @default(uuid())
  projectId       String?
  organizationId  String
  downPayment     Decimal         @db.Decimal(14, 2)
  principal       Decimal         @db.Decimal(14, 2)
  termMonths      Int
  annualInterest  Decimal         @db.Decimal(8, 4)
  cet             Decimal         @db.Decimal(8, 4)
  system          FinancingSystem
  firstPayment    Decimal         @db.Decimal(14, 2)
  lastPayment     Decimal         @db.Decimal(14, 2)
  totalInterest   Decimal         @db.Decimal(14, 2)
  totalCost       Decimal         @db.Decimal(14, 2)
  schedule        Json
  createdAt       DateTime        @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ConsortiumSimulation {
  id                String   @id @default(uuid())
  projectId         String?
  organizationId    String
  letterValue        Decimal  @db.Decimal(14, 2)
  adminFee           Decimal  @db.Decimal(8, 4)
  reserveFund        Decimal  @db.Decimal(8, 4)
  insurance          Decimal  @db.Decimal(8, 4)
  embeddedBid        Decimal  @default(0) @db.Decimal(14, 2)
  ownBid             Decimal  @default(0) @db.Decimal(14, 2)
  expectedAwardMonth Int?
  totalCost          Decimal  @db.Decimal(14, 2)
  delayRisk          RiskLevel
  comparisonPayload  Json
  createdAt          DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ConstructionBudget {
  id           String   @id @default(uuid())
  projectId    String
  name         String
  plannedCost  Decimal  @db.Decimal(14, 2)
  actualCost   Decimal  @default(0) @db.Decimal(14, 2)
  contingency  Decimal  @default(0) @db.Decimal(8, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ConstructionStage {
  id              String   @id @default(uuid())
  projectId       String
  name            String
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  budget          Decimal  @default(0) @db.Decimal(14, 2)
  actualCost      Decimal  @default(0) @db.Decimal(14, 2)
  progressPercent Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materials Material[]
}

model Material {
  id        String   @id @default(uuid())
  projectId String
  stageId   String?
  supplierId String?
  name      String
  quantity  Decimal  @db.Decimal(14, 3)
  unit      String
  unitPrice Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    ConstructionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  supplier Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  contact        String?
  city           String?
  rating         Int?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  materials    Material[]
}

model FinancialTransaction {
  id             String          @id @default(uuid())
  organizationId String
  projectId      String?
  type           TransactionType
  description    String
  amount         Decimal         @db.Decimal(14, 2)
  dueDate        DateTime
  paidAt         DateTime?
  category       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model RegionResearch {
  id             String   @id @default(uuid())
  organizationId String
  city           String
  state          String
  neighborhood   String?
  pricePerM2     Decimal? @db.Decimal(14, 2)
  averageRent    Decimal? @db.Decimal(14, 2)
  appreciation   Decimal? @db.Decimal(8, 4)
  safetyScore    Int?
  liquidityScore Int?
  demandScore    Int?
  incomeScore    Int?
  urbanGrowth    Int?
  finalScore     Int?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ExternalDataSource {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  sourceType     String
  date           DateTime
  reliability    Int
  url            String?
  payload        Json?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BusinessIdea {
  id              String        @id @default(uuid())
  organizationId  String
  title           String
  risk            RiskLevel     @default(MEDIUM)
  requiredCapital Decimal       @db.Decimal(14, 2)
  expectedProfit  Decimal       @db.Decimal(14, 2)
  priority        Int           @default(3)
  nextSteps       String?
  status          ProjectStatus @default(IDEA)
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DecisionReport {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  title          String
  reportType     String
  verdict        String
  content        Json
  pdfUrl         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model FileAttachment {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  bucket         String
  path           String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  entity         String
  entityId       String
  action         String
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Task {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  assigneeId     String?
  title          String
  checklist      Json?
  priority       Int      @default(3)
  dueDate        DateTime?
  comments       Json?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Alert {
  id             String        @id @default(uuid())
  organizationId String
  projectId      String?
  title          String
  message        String
  severity       AlertSeverity @default(INFO)
  category       String
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model AIAnalysis {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  question       String
  answer         String
  inputs         Json
  confidence     Decimal  @default(0) @db.Decimal(8, 4)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model LoanProposal {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String?
  lender         String
  kind           String
  amount         Decimal   @db.Decimal(14, 2)
  termMonths     Int
  annualInterest Decimal   @db.Decimal(8, 4)
  cet            Decimal   @db.Decimal(8, 4)
  traps          Json?
  riskLevel      RiskLevel @default(MEDIUM)
  verdict        String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model FinancialHealth {
  id             String   @id @default(uuid())
  organizationId String
  liquidity      Decimal  @db.Decimal(14, 2)
  cash           Decimal  @db.Decimal(14, 2)
  assets         Decimal  @db.Decimal(14, 2)
  debt           Decimal  @db.Decimal(14, 2)
  emergencyFund  Decimal  @db.Decimal(14, 2)
  riskScore      Int
  status         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WealthProjection {
  id             String   @id @default(uuid())
  organizationId String
  horizonYears   Int
  initialWealth  Decimal  @db.Decimal(14, 2)
  projectedWealth Decimal @db.Decimal(14, 2)
  assumptions    Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
